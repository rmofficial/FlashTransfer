<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <!-- Brand header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="62dp">

                <View
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_glow" />

                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:contentDescription="Flash Transfer logo"
                    android:src="@drawable/ic_logo" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.005"
                        android:text="Flash Transfer"
                        android:textColor="@color/text"
                        android:textSize="23sp" />

                    <TextView
                        style="@style/PillGold"
                        android:layout_marginStart="8dp"
                        android:text="PRO" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:letterSpacing="0.02"
                    android:text="Premium Wi-Fi file sharing"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                style="@style/Pill"
                android:layout_marginStart="8dp"
                android:text="v1.0.8" />
        </LinearLayout>

        <!-- Live status + telemetry -->
        <LinearLayout style="@style/Card" android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewDot"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:background="@drawable/dot_off" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Server offline"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Pill"
                    android:text="LOCAL • PRIVATE" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_tile"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/StatLabel"
                        android:text="SPEED" />

                    <TextView
                        android:id="@+id/tvSpeed"
                        style="@style/StatValue"
                        android:text="0 B/s"
                        android:textColor="@color/amber" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_tile"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/StatLabel"
                        android:text="TIME LEFT" />

                    <TextView
                        android:id="@+id/tvEta"
                        style="@style/StatValue"
                        android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_tile"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/StatLabel"
                        android:text="SENT" />

                    <TextView
                        android:id="@+id/tvSent"
                        style="@style/StatValue"
                        android:text="0 B" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_tile"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/StatLabel"
                        android:text="ACTIVE" />

                    <TextView
                        android:id="@+id/tvActive"
                        style="@style/StatValue"
                        android:text="0" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Primary action -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_btn_primary"
            android:drawableStart="@drawable/ic_stat_bolt"
            android:drawablePadding="10dp"
            android:drawableTint="@color/ink"
            android:letterSpacing="0.02"
            android:stateListAnimator="@null"
            android:text="START SERVER"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- QR / connection -->
        <LinearLayout
            android:id="@+id/cardQr"
            style="@style/Card"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="CONNECTION" />

                <TextView
                    style="@style/Pill"
                    android:text="●  READY TO SCAN"
                    android:textColor="@color/green" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_qr"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/ivQr"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:contentDescription="QR code" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:text="http://"
                android:textColor="@color/amber"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCopy"
                    style="@style/SmallBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Copy" />

                <Button
                    android:id="@+id/btnShare"
                    style="@style/SmallBtn"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Share" />

                <Button
                    android:id="@+id/btnOpen"
                    style="@style/SmallBtn"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Open" />
            </LinearLayout>
        </LinearLayout>

        <!-- Configuration -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_accent_bar" />

                <TextView
                    style="@style/Label"
                    android:layout_marginStart="8dp"
                    android:text="CONFIGURATION" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:layout_marginTop="20dp"
                android:text="SHARED FOLDER" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvFolder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnFolder"
                    style="@style/SmallBtn"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_height="40dp"
                    android:text="Change" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:layout_marginTop="18dp"
                android:text="PORT" />

            <EditText
                android:id="@+id/etPort"
                style="@style/Input"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="5"
                android:text="8181" />

            <TextView
                style="@style/Label"
                android:layout_marginTop="18dp"
                android:text="PASSWORD (OPTIONAL)" />

            <EditText
                android:id="@+id/etPass"
                style="@style/Input"
                android:hint="Empty = no login"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="If set, the browser asks for login. Username: admin"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Quick tools -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_accent_bar" />

                <TextView
                    style="@style/Label"
                    android:layout_marginStart="8dp"
                    android:text="QUICK TOOLS" />
            </LinearLayout>

            <Button
                android:id="@+id/btnHotspot"
                style="@style/SmallBtn"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:gravity="start|center_vertical"
                android:text="📶  Open Hotspot settings" />

            <Button
                android:id="@+id/btnBattery"
                style="@style/SmallBtn"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:gravity="start|center_vertical"
                android:text="🔋  Allow background running" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_info_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/Label"
                    android:text="PRO TIP" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Turn on Hotspot on this phone (or put both phones on the same Wi-Fi), press START, then scan the QR from the other phone and connect it to this Wi-Fi."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="© 2026 Rahul Mandal  •  Tap for About"
            android:textColor="#FF5D6F8F"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
