<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#FF04070D"
                android:startColor="#FF0A1526" />
        </shape>
    </item>
    <item
        android:gravity="top|center_horizontal"
        android:height="460dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#1AFF7A18"
                android:centerX="0.5"
                android:centerY="0.1"
                android:endColor="#00000000"
                android:gradientRadius="320dp"
                android:startColor="#40FFB020"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:gravity="bottom|center_horizontal"
        android:height="380dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#0F4C8BF5"
                android:centerX="0.5"
                android:centerY="0.9"
                android:endColor="#00000000"
                android:gradientRadius="280dp"
                android:startColor="#244C8BF5"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
